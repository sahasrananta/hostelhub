# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production builds
frontend/dist/

# Local Environment Variables
.env
*.env
backend/.env
frontend/.env
*.env.local

# SQLite Database files (generated in production/runtime)
backend/*.db
backend/*.db-journal
backend/*.db-shm
backend/*.db-wal

# Uploaded media (preserve directory via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/hostels/*
!backend/uploads/hostels/.gitkeep

# System & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
